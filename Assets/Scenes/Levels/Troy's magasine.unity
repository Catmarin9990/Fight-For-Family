  dialogue:
    image:
    - {fileID: 21300000, guid: 80a5e913f107f6f418baec42ca3854da, type: 3}
    - {fileID: 21300000, guid: 92854f899f0ebc243b090a3c050951b7, type: 3}
    - {fileID: 21300000, guid: 92854f899f0ebc243b090a3c050951b7, type: 3}
    - {fileID: 21300000, guid: 92854f899f0ebc243b090a3c050951b7, type: 3}
    sentenses:
    - "Hey, sorry about your brother. They\u2019ll pay for what they\u2019ve done."
    - "But you can\u2019t go there empty handed, you need a firearm."
    - "C\u2019mon take the AR and the pistol to practice on the dummies.\n"
    - "Nice but unfortunately, I can\u2019t give you the AR that thing doesn\u2019t
      grow on trees so just take the pistol with you."
